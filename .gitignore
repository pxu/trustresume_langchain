# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.env.*
!.env.example

# --- Candidate data & secrets (never commit real user documents or credentials) ---
data/user_documents/
data/processed/*
!data/processed/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep
chroma_data/
*.db
*.sqlite3

# --- Local LLM config overlay (may hold an API key — never commit) ---
config/llm.local.json

# --- Tests / tooling ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
.playwright-mcp/

# --- OS / IDE ---
.DS_Store
.vscode/
.idea/

# --- Generated résumés + evaluations ---------------------------------------
# Real runs write here (TRUSTRESUME_OUTPUT_DIR, default "output/"), keyed by
# user id — that is real candidate data and must never be committed.
#
# output/samples/ is the deliberate exception: it holds the curated, fully
# synthetic demo artifacts produced by scripts/generate_samples.py, which are
# committed so the pass/fail examples are readable on GitHub without cloning.
# The evidence and job postings behind them are invented (see that script).
#
# Structured as "ignore everything under output/, then un-ignore samples/"
# rather than as a bare `output/` rule, because git cannot re-include a path
# whose parent directory is itself excluded.
output/*
!output/samples/
